fn main(args Array<String>) {
    let nums Array<Int64>: [10, 20, 30]
    printLn(nums.len())
    printLn(nums.at(0))
    printLn(nums.at(2))

    nums.set(99, 1)
    printLn(nums.at(1))

    nums.add(40)
    printLn(nums.len())
    printLn(nums.at(3))

    let nums2 Array<Int64>: nums.slice(1, 3)
    printLn(nums2.len())
    printLn(nums2.at(0))

    // clone: independent copy — mutating the clone does not affect the original
    let nums3 Array<Int64>: clone(nums)
    printLn(nums3.len())
    printLn(nums3.at(0))
    nums3.set(777, 0)
    printLn(nums3.at(0))
    printLn(nums.at(0))

    drop(nums3)

    // Array<String> clone and drop (recursive element clone/drop)
    let words Array<String>: ["hello", "world"]
    let words2 Array<String>: clone(words)
    printLn(words2.len())
    printLn(words2.at(0))
    drop(words2)
    drop(words)

    // array returned from function
    let fromInt Array<Int64>: generateArrayInt()
    printLn(fromInt.len())
    printLn(fromInt.at(0))
    drop(fromInt)

    let fromStr Array<String>: generateArrayString()
    printLn(fromStr.len())
    printLn(fromStr.at(0))
    drop(fromStr)

    // array passed to function
    let testArr Array<Int64>: [5, 6, 7]
    printLn(firstElement(testArr))
    drop(testArr)
}

fn generateArrayInt() Array<Int64> {
    return [1,2,3,4]
}

fn generateArrayString() Array<String> {
    return ["1 one","2 two","3 three","4 four"]
}

fn firstElement(arr Array<Int64>) Int64 {
    return arr.at(0)
}
