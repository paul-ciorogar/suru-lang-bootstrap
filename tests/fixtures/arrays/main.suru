fn main(args Array) Int64 {
    let nums: [10, 20, 30]
    printLn(nums.len())
    printLn(nums.at(0))
    printLn(nums.at(2))
    nums.set(99, 1)
    printLn(nums.at(1))
    nums.add(40)
    printLn(nums.len())
    printLn(nums.at(3))
    let nums2: nums.slice(1, 3)
    printLn(nums2.len())
    printLn(nums2.at(0))
    return 0
}
