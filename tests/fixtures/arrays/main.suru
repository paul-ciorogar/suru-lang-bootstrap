fn main(args Array<String>) {
    let nums Array<Int64>: [10, 20, 30]
    printLn(nums.len())
    printLn(nums.at(0))
    printLn(nums.at(2))

    nums.set(99, 1)
    printLn(nums.at(1))

    nums.add(40)
    printLn(nums.len())
    printLn(nums.at(3))

    let nums2 Array<Int64>: nums.slice(1, 3)
    printLn(nums2.len())
    printLn(nums2.at(0))

    // let numsFromFn: generateArrayInt()
    // printLn(numsFromFn.len())
    // printLn(numsFromFn.at(2))

    // let numsFromString: generateArrayString()
    // printLn(numsFromString.len())
    // printLn(numsFromString.at(2))

}

fn generateArrayInt() Array<Int64> {
    return [1,2,3,4]
}

fn generateArrayString() Array<String> {
    return ["1 one","2 two","3 three","4 four"]
}
