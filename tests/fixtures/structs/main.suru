type DataStruct: { tall Bool, height Int64 }
type Named: { name String, height Int64 }
type Lvl3: { someValue Int64 }
type Lvl2: { anotherParam Lvl3 }
type Lvl1: { otherParam Lvl2 }
type Parent: { someArray Array<Lvl1> }

fn structFromFunction() Named {
    return {
        name: "Suru"
        height: 2283
    }
}

fn getHeight(data Named) Int64 {
    return data.height
}

fn main(args Array<String>) {
    // basic: field read/write/clone/drop
    let data DataStruct: { tall: true, height: 2283 }
    printLn(data.tall)
    printLn(data.height)
    data.tall: false
    printLn(data.tall)
    let copy DataStruct: clone(data)
    printLn(copy.tall)
    drop(data)
    drop(copy)

    // struct returned from function — extract via typed let
    let suru Named: structFromFunction()
    let suruName String: suru.name
    printLn(suruName)
    let suruHeight Int64: suru.height
    printLn(suruHeight)
    drop(suru)

    // struct passed to function, field returned
    let tok Named: { name: "hello", height: 42 }
    let h Int64: getHeight(tok)
    printLn(h)
    drop(tok)

    // deep chain via let intermediaries:
    // covers struct.someArray.at(i).nested.deeper.value
    let lvl3 Lvl3: { someValue: 99 }
    let lvl2 Lvl2: { anotherParam: lvl3 }
    let lvl1 Lvl1: { otherParam: lvl2 }
    let someArray Array<Lvl1>: [lvl1]
    let parent Parent: { someArray: someArray }

    let arr Array<Lvl1>: parent.someArray
    let item Lvl1: arr.at(0)
    let l1 Lvl2: item.otherParam
    let l2 Lvl3: l1.anotherParam
    let deepVal Int64: l2.someValue
    printLn(deepVal)
}
