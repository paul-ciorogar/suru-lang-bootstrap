fn identity(d Struct) Struct {
    return d
}

fn main(args Array<String>) {
    let data Struct: { tall: true, height: 2283 }
    printLn(data.tall)
    printLn(data.height)

    data.tall: false
    printLn(data.tall)

    let copy Struct: clone(data)
    printLn(copy.tall)

    drop(data)

