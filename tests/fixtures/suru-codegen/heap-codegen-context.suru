// Stage 14d — Heap Codegen Context Types
//
// Extended context for heap type codegen (String, Array, Struct).
// HeapCodegenContext extends the Stage 14b CodegenContext with:
//   - type registry (TypeDecl) for struct field lookup
//   - suruType tracking on every variable (e.g. "String", "Array:Int64", "Named")
//   - separate accumulators for string globals, helper fns, and function bodies
//     so the final .ll output can be assembled in the correct order:
//     preamble (header+decls) | strGlobals | helpers | fn bodies
//   - strIndex for pre-registered string literal globals (populated before fn emit)
//   - strCount for unique naming of string globals and clone/drop temps
//
// suruType encoding:
//   scalars:       "Int64" | "Bool" | "Int32" | "Float64"
//   heap strings:  "String"
//   heap arrays:   "Array:" + elemSuruType  (e.g. "Array:Int64", "Array:Lvl1")
//   heap structs:  the declared type name   (e.g. "Named", "DataStruct")

include "codegen-types.suru" as cg
include "ir-builder.suru"    as ir

// ─── Type registry ────────────────────────────────────────────────────────────

// One field in a TypeDecl.  typeName is the Suru type annotation string.
type TypeFieldEntry: { name String, typeName String }

// Compiled view of a TypeDeclaration AST node.  Populated from TypeDeclNode nodes
// in a pre-pass so struct field layout is available during codegen.
type TypeDecl: { name String, fields Array<TypeFieldEntry> }

// Compiled view of a SumTypeDeclaration AST node.  Populated from SumTypeDeclNode nodes
// in a pre-pass so variant indices are available during match dispatch codegen.
type SumTypeDecl: { name String, variants Array<String> }

// ─── String literal registry ──────────────────────────────────────────────────

// Maps a string literal text to its pre-assigned LLVM global name (@.str_N).
// Populated by scanStringLiterals / registerStringLiterals before fn bodies are emitted.
type StrIndexEntry: { text String, globalName String }

// ─── Extended variable entry ──────────────────────────────────────────────────

// Variable entry extended with suruType so method dispatch (string/array/struct)
// can route correctly without re-parsing the llvmType (which is always "ptr" for heap).
type HeapVarEntry: { name String, allocaName String, llvmType String, suruType String }

// ─── Context and result ───────────────────────────────────────────────────────

// All state threaded through heap-type codegen functions.
// builder    — accumulated preamble (header + decls)
// fns        — accumulated function body text (appended after emitHFnDecl)
// strGlobals — accumulated @.str_N global lines (emitted between decls and helpers)
// helpers    — accumulated @suru_clone_T / @suru_drop_T function bodies
// strCount   — monotonically increasing counter for unique names
type HeapCodegenContext: {
    builder              IrBuilder
    fns                  String
    strGlobals           String
    decls                String
    suruDecls            String
    extCloneDropDecls    String
    helpers              String
    vars                 Array<HeapVarEntry>
    fnSigs               Array<FnSig>
    types                Array<TypeDecl>
    sumTypes             Array<SumTypeDecl>
    strIndex             Array<StrIndexEntry>
    strCount             Int64
    currentReturnType    String
    currentReturnName    String
    blockOpen            Bool
    declares             Array<String>
    ownTypeNames         Array<String>
}

// Returned by value-producing heap emitters.
// suruType carries the Suru type name so callers can dispatch further method calls.
type HeapCodegenResult: { ctx HeapCodegenContext, name String, llvmType String, suruType String }

// ─── Constructor ─────────────────────────────────────────────────────────────

fn makeHeapContext() HeapCodegenContext {
    let vars         Array<HeapVarEntry>:  []
    let fnSigs       Array<FnSig>:         []
    let types        Array<TypeDecl>:      []
    let sumTypes     Array<SumTypeDecl>:   []
    let idx          Array<StrIndexEntry>: []
    let decl         Array<String>:        []
    let ownTypeNames Array<String>:        []
    return {
        builder:              ir.makeBuilder()
        fns:                  ""
        strGlobals:           ""
        decls:                ""
        suruDecls:            ""
        extCloneDropDecls:    ""
        helpers:              ""
        vars:                 vars
        fnSigs:               fnSigs
        types:                types
        sumTypes:             sumTypes
        strIndex:             idx
        strCount:             0
        currentReturnType:    ""
        currentReturnName:    ""
        blockOpen:            false
        declares:             decl
        ownTypeNames:         ownTypeNames
    }
}

// ─── Single-field updaters ────────────────────────────────────────────────────

fn withHBuilder(ctx HeapCodegenContext, b IrBuilder) HeapCodegenContext {
    return { builder: b, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHBlockOpen(ctx HeapCodegenContext, open Bool) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: open, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHReturnType(ctx HeapCodegenContext, retType String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: retType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHReturnName(ctx HeapCodegenContext, rn String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: rn, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHStrCount(ctx HeapCodegenContext, n Int64) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: n, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHStrGlobals(ctx HeapCodegenContext, sg String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: sg, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHDecls(ctx HeapCodegenContext, d String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: d, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHSuruDecls(ctx HeapCodegenContext, d String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: d, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHFns(ctx HeapCodegenContext, fns String) HeapCodegenContext {
    return { builder: ctx.builder, fns: fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHHelpers(ctx HeapCodegenContext, helpers String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHExtCloneDropDecls(ctx HeapCodegenContext, d String) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: d, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: ctx.ownTypeNames }
}

fn withHOwnTypeNames(ctx HeapCodegenContext, names Array<String>) HeapCodegenContext {
    return { builder: ctx.builder, fns: ctx.fns, strGlobals: ctx.strGlobals, decls: ctx.decls, suruDecls: ctx.suruDecls, extCloneDropDecls: ctx.extCloneDropDecls, helpers: ctx.helpers, vars: ctx.vars, fnSigs: ctx.fnSigs, types: ctx.types, sumTypes: ctx.sumTypes, strIndex: ctx.strIndex, strCount: ctx.strCount, currentReturnType: ctx.currentReturnType, currentReturnName: ctx.currentReturnName, blockOpen: ctx.blockOpen, declares: ctx.declares, ownTypeNames: names }
}

// ─── Declaration tracker ─────────────────────────────────────────────────────

// addDecl appends `line` to ctx.decls (C runtime externals) only if not already declared.
// Mirrors C# Externals.Add* — malloc/free/fopen/strlen/exit go here (one space before @).
fn addDecl(ctx HeapCodegenContext, line String) HeapCodegenContext {
    let i Int64: 0
    while i.lt(ctx.declares.len()) {
        match ctx.declares.at(i).equals(line) { true: { return ctx } _: {} }
        i: i.add(1)
    }
    ctx.declares.add(line)
    return withHDecls(ctx, ctx.decls.append(line))
}

// addSuruDecl appends `line` to ctx.suruDecls (Suru runtime declares) only if not already declared.
// Mirrors C# SuruRuntimeDeclarations.Add* — suru_clone_dyn/suru_string_*/etc go here (two spaces).
fn addSuruDecl(ctx HeapCodegenContext, line String) HeapCodegenContext {
    let i Int64: 0
    while i.lt(ctx.declares.len()) {
        match ctx.declares.at(i).equals(line) { true: { return ctx } _: {} }
        i: i.add(1)
    }
    ctx.declares.add(line)
    return withHSuruDecls(ctx, ctx.suruDecls.append(line))
}

// addExtCloneDropDecl appends external type clone/drop declare stubs to ctx.extCloneDropDecls.
// Idempotent — uses ctx.declares set to avoid duplicate stubs for the same type.
// Mirrors C# _externalTypeCloneDrop HashSet + sb.AppendLine in IRCodeGenerator.Emit().
fn addExtCloneDropDecl(ctx HeapCodegenContext, typeName String) HeapCodegenContext {
    let cloneLine String: "declare ptr  @suru_clone_".append(typeName).append("(ptr)\n")
    let dropLine  String: "declare void @suru_drop_".append(typeName).append("(ptr)\n")
    let i Int64: 0
    while i.lt(ctx.declares.len()) {
        match ctx.declares.at(i).equals(cloneLine) { true: { return ctx } _: {} }
        i: i.add(1)
    }
    ctx.declares.add(cloneLine)
    let newDecls String: ctx.extCloneDropDecls.append(cloneLine).append(dropLine)
    return withHExtCloneDropDecls(ctx, newDecls)
}

// ─── Variable table ───────────────────────────────────────────────────────────

fn lookupHVar(ctx HeapCodegenContext, name String) HeapVarEntry {
    let vars Array<HeapVarEntry>: ctx.vars
    let i Int64: 0
    while i.lt(vars.len()) {
        let e HeapVarEntry: vars.at(i)
        match e.name.equals(name) { true: { return e } _: {} }
        i: i.add(1)
    }
    return { name: "", allocaName: "", llvmType: "", suruType: "" }
}

fn addHVar(ctx HeapCodegenContext, name String, allocaName String, llvmType String, suruType String) HeapCodegenContext {
    // Overwrite existing binding if present — matches C# Dictionary<> assignment semantics
    // so that re-declaring a variable in a second while loop (e.g. `let s AstNode: ...`)
    // updates the alloca pointer rather than shadowing it with a stale old entry.
    let i Int64: 0
    while i.lt(ctx.vars.len()) {
        let v HeapVarEntry: ctx.vars.at(i)
        match v.name.equals(name) {
            true: {
                ctx.vars.set({ name: name, allocaName: allocaName, llvmType: llvmType, suruType: suruType }, i)
                return ctx
            }
            _: {}
        }
        i: i.add(1)
    }
    ctx.vars.add({ name: name, allocaName: allocaName, llvmType: llvmType, suruType: suruType })
    return ctx
}

// Update an existing variable's suruType in ctx.vars (first match, linear scan).
// Caller must save the original entry and restore it after the narrowed region.
fn updateHVar(ctx HeapCodegenContext, varName String, entry HeapVarEntry) HeapCodegenContext {
    let i Int64: 0
    while i.lt(ctx.vars.len()) {
        let v HeapVarEntry: ctx.vars.at(i)
        match v.name.equals(varName) {
            true: {
                ctx.vars.set(entry, i)
                return ctx
            }
            _: {}
        }
        i: i.add(1)
    }
    return ctx
}

// True when name is a declared sum type (e.g. "AstNode", "Shape").
// Used to dispatch match statements on sum-type conditions (e.g. match node { CallNode: … })
// even when the condition variable is not itself a variant of another sum type.
fn isSumType(ctx HeapCodegenContext, name String) Bool {
    let i Int64: 0
    while i.lt(ctx.sumTypes.len()) {
        match ctx.sumTypes.at(i).name.equals(name) { true: { return true } _: {} }
        i: i.add(1)
    }
    return false
}

// ─── Function registry ────────────────────────────────────────────────────────

fn lookupHFn(ctx HeapCodegenContext, name String) FnSig {
    let i Int64: 0
    while i.lt(ctx.fnSigs.len()) {
        let s FnSig: ctx.fnSigs.at(i)
        match s.name.equals(name) { true: { return s } _: {} }
        i: i.add(1)
    }
    return { name: "", returnLlvmType: "", returnSuruType: "" }
}

fn addHFn(ctx HeapCodegenContext, name String, retLlvmType String, retSuruType String) HeapCodegenContext {
    ctx.fnSigs.add({ name: name, returnLlvmType: retLlvmType, returnSuruType: retSuruType })
    return ctx
}

// ─── Type registry ────────────────────────────────────────────────────────────

fn lookupHType(ctx HeapCodegenContext, name String) TypeDecl {
    let i Int64: 0
    while i.lt(ctx.types.len()) {
        let d TypeDecl: ctx.types.at(i)
        match d.name.equals(name) { true: { return d } _: {} }
        i: i.add(1)
    }
    let empty Array<TypeFieldEntry>: []
    return { name: "", fields: empty }
}

fn addHType(ctx HeapCodegenContext, decl TypeDecl) HeapCodegenContext {
    ctx.types.add(decl)
    return ctx
}

// ─── Sum type registry ────────────────────────────────────────────────────────

fn addHSumType(ctx HeapCodegenContext, decl SumTypeDecl) HeapCodegenContext {
    ctx.sumTypes.add(decl)
    return ctx
}

fn lookupSumType(ctx HeapCodegenContext, name String) SumTypeDecl {
    let i Int64: 0
    while i.lt(ctx.sumTypes.len()) {
        let d SumTypeDecl: ctx.sumTypes.at(i)
        match d.name.equals(name) { true: { return d } _: {} }
        i: i.add(1)
    }
    let empty Array<String>: []
    return { name: "", variants: empty }
}

// Returns the 0-based index of variantName in sumType.variants, or -1 if not found.
fn variantIdx(sumType SumTypeDecl, variantName String) Int64 {
    let i Int64: 0
    while i.lt(sumType.variants.len()) {
        match sumType.variants.at(i).equals(variantName) { true: { return i } _: {} }
        i: i.add(1)
    }
    return -1
}

// True when name appears as a variant in any registered sum type.
fn isVariant(ctx HeapCodegenContext, name String) Bool {
    let i Int64: 0
    while i.lt(ctx.sumTypes.len()) {
        let d SumTypeDecl: ctx.sumTypes.at(i)
        let j Int64: 0
        while j.lt(d.variants.len()) {
            match d.variants.at(j).equals(name) { true: { return true } _: {} }
            j: j.add(1)
        }
        i: i.add(1)
    }
    return false
}

// Walk sumTypes to find the SumTypeDecl that contains variantName.
// Returns an empty decl if not found.
fn findParentForVariant(ctx HeapCodegenContext, variantName String) SumTypeDecl {
    let i Int64: 0
    while i.lt(ctx.sumTypes.len()) {
        let sd SumTypeDecl: ctx.sumTypes.at(i)
        let j Int64: 0
        while j.lt(sd.variants.len()) {
            match sd.variants.at(j).equals(variantName) { true: { return sd } _: {} }
            j: j.add(1)
        }
        i: i.add(1)
    }
    let empty Array<String>: []
    return { name: "", variants: empty }
}

fn lookupHField(decl TypeDecl, fieldName String) TypeFieldEntry {
    let i Int64: 0
    while i.lt(decl.fields.len()) {
        let f TypeFieldEntry: decl.fields.at(i)
        match f.name.equals(fieldName) { true: { return f } _: {} }
        i: i.add(1)
    }
    return { name: "", typeName: "" }
}

fn fieldIndex(decl TypeDecl, fieldName String) Int64 {
    let i Int64: 0
    while i.lt(decl.fields.len()) {
        match decl.fields.at(i).name.equals(fieldName) { true: { return i } _: {} }
        i: i.add(1)
    }
    return -1
}

// ─── String literal index ─────────────────────────────────────────────────────

fn lookupStrGlobal(ctx HeapCodegenContext, text String) String {
    let i Int64: 0
    while i.lt(ctx.strIndex.len()) {
        let e StrIndexEntry: ctx.strIndex.at(i)
        match e.text.equals(text) { true: { return e.globalName } _: {} }
        i: i.add(1)
    }
    return ""
}

fn addStrIndex(ctx HeapCodegenContext, text String, globalName String) HeapCodegenContext {
    ctx.strIndex.add({ text: text, globalName: globalName })
    return ctx
}

// ─── Type classification helpers ──────────────────────────────────────────────

fn isScalarSuruType(suruType String) Bool {
    match suruType.equals("Int64")   { true: { return true } _: {} }
    match suruType.equals("Bool")    { true: { return true } _: {} }
    match suruType.equals("Int32")   { true: { return true } _: {} }
    match suruType.equals("Float64") { true: { return true } _: {} }
    return false
}

// True when suruType encodes an array (e.g. "Array:Int64", "Array:Lvl1").
fn isArraySuruType(suruType String) Bool {
    match suruType.len().lt(6) { true: { return false } _: {} }
    return suruType.slice(0, 6).equals("Array:")
}

// Extract the element Suru type from an array suruType like "Array:Int64" → "Int64".
fn elemSuruType(suruType String) String {
    return suruType.slice(6, suruType.len())
}

// True when a type annotation string names an Array (e.g. "Array<Int64>").
// Must check for "Array<" (with angle bracket) to avoid matching user-defined
// types whose names begin with "Array" (e.g. ArrayLitNode).
fn isArrayTypeName(typeName String) Bool {
    match typeName.len().lt(6) { true: { return false } _: {} }
    return typeName.slice(0, 6).equals("Array<")
}

// Extract the element type from a generic type annotation: "Array<Int64>" → "Int64".
fn extractElemType(typeName String) String {
    let i Int64: 0
    let start Int64: -1
    while i.lt(typeName.len()) {
        match typeName.at(i).equals("<") { true: { start: i } _: {} }
        i: i.add(1)
    }
    match start.equals(-1) { true: { return "" } _: {} }
    return typeName.slice(start.add(1), typeName.len().take(1))
}

// Convert a Suru type annotation name to the suruType encoding used in HeapVarEntry.
fn makeSuruType(typeName String) String {
    match isArrayTypeName(typeName) {
        true: { return "Array:".append(extractElemType(typeName)) }
        _: {}
    }
    return typeName
}

// LLVM type for a Suru type name (replicates cg.llvmTypeOf for heap-context use).
fn heapLlvmTypeOf(suruType String) String {
    // Void functions use ptr return type in the C# codegen convention (ret ptr null).
    match suruType.equals("void")    { true: { return "ptr"    } _: {} }
    match suruType.equals("Int64")   { true: { return "i64"    } _: {} }
    match suruType.equals("Bool")    { true: { return "i1"     } _: {} }
    match suruType.equals("Int32")   { true: { return "i32"    } _: {} }
    match suruType.equals("Float64") { true: { return "double" } _: {} }
    return "ptr"
}

// True when the given name appears in an Array<String> names list.
// Used to distinguish own vs external function/type names in per-module emit.
fn namesContain(names Array<String>, name String) Bool {
    let i Int64: 0
    while i.lt(names.len()) {
        match names.at(i).equals(name) { true: { return true } _: {} }
        i: i.add(1)
    }
    return false
}

// SuruType integer type_tag for a Suru type name (for array elem_tag).
fn suruTypeTag(suruType String) String {
    match suruType.equals("Bool")    { true: { return "0" } _: {} }
    match suruType.equals("Int32")   { true: { return "1" } _: {} }
    match suruType.equals("Int64")   { true: { return "2" } _: {} }
    match suruType.equals("Float64") { true: { return "3" } _: {} }
    match suruType.equals("String")  { true: { return "6" } _: {} }
    match isArraySuruType(suruType)  { true: { return "5" } _: {} }
    return "4"
}
