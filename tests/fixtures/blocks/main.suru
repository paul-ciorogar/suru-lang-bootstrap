// Eight nested scopes, each shadowing 'x' with its own depth. Each level prints on the
// way in and again on the way out, so the output ramps up and back down: every level's
// slot has to survive the inner shadow that hid it.

let base i64: 100
let x i64: 1
printLn(x)
{
  let x i64: 2
  printLn(x)
  {
    let x i64: 3
    printLn(x)
    {
      let x i64: 4
      printLn(x)
      {
        let x i64: 5
        printLn(x)
        {
          let x i64: 6
          printLn(x)
          {
            let x i64: 7
            printLn(x)
            {
              let x i64: 8
              printLn(x)
              // 'base' is bound outermost and shadowed nowhere: a lookup out through
              // all eight frames.
              printLn(base + x)
            }
            printLn(x)
          }
          printLn(x)
        }
        printLn(x)
      }
      printLn(x)
    }
    printLn(x)
  }
  printLn(x)
}
printLn(x)
