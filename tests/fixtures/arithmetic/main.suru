fn main(args Array<String>) {
    let x Int64: 2.add(3)
    printLn(x)

    let y Int64: 10.take(4)
    printLn(y)

    let z Int64: 3.multiply(2)
    printLn(z)

    let w Int64: 9.split(3)
    printLn(w)

    let n Int64: 5.invert()
    printLn(n)

    let a Bool: true
    let b Bool: false
    printLn(a)
    printLn(b)

    let p Int32: 7
    let q Int32: 3
    printLn(p)
    printLn(q)
}
