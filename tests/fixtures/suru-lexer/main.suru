include "suru-lexer.suru" as lexer

fn main(args Array<String>) {
    let source String: readFile(args.at(1))
    let tokens Array<Token>: lexer.tokenize(source)
    let i Int64: 0
    while i.lt(tokens.len()) {
        let tok Token: tokens.at(i)
        printLn(tok.kind.toString().append(" ").append(tok.text).append(" ").append(tok.line.toString()).append(":").append(tok.col.toString()))
        i: i.add(1)
    }
}
