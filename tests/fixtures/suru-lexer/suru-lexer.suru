let TOK_EOF Int64:       0
let TOK_IDENT Int64:     1
let TOK_TRUE Int64:      2
let TOK_FALSE Int64:     3
let TOK_INT Int64:       4
let TOK_FLOAT Int64:     5
let TOK_STRING Int64:    6
let TOK_LPAREN Int64:    7
let TOK_RPAREN Int64:    8
let TOK_COMMA Int64:     9
let TOK_DOT Int64:       10
let TOK_COLON Int64:     11
let TOK_LBRACE Int64:    12
let TOK_RBRACE Int64:    13
let TOK_LBRACKET Int64:  14
let TOK_RBRACKET Int64:  15
let TOK_LET Int64:       16
let TOK_NOT Int64:       17
let TOK_AND Int64:       18
let TOK_OR Int64:        19
let TOK_MATCH Int64:     20
let TOK_WILDCARD Int64:  21
let TOK_FN Int64:        22
let TOK_RETURN Int64:    23
let TOK_VOID Int64:      24
let TOK_MINUS Int64:     25
let TOK_WHILE Int64:     26
let TOK_LT Int64:        27
let TOK_GT Int64:        28
let TOK_INCLUDE Int64:   29
let TOK_AS Int64:        30

fn isDigit(ch String) Bool {
    let c Int64: ch.ord()
    return c.gte(48) and c.lt(58)
}

fn isLetter(ch String) Bool {
    let c Int64: ch.ord()
    let lower Bool: c.gte(97) and c.lt(123)
    let upper Bool: c.gte(65) and c.lt(91)
    return lower or upper
}

fn isLetterDigitUnderscore(ch String) Bool {
    return isLetter(ch) or isDigit(ch) or ch.equals("_")
}

fn isWhitespace(ch String) Bool {
    return ch.equals(" ") or ch.equals("\n") or ch.equals("\t")
}

fn makeToken(kind Int64, text String, line Int64, col Int64) Struct {
    return { kind Int64: kind, text String: text, line Int64: line, col Int64: col }
}

fn keywordKind(text String) Int64 {
    return match text {
        "true":   TOK_TRUE
        "false":  TOK_FALSE
        "let":    TOK_LET
        "not":    TOK_NOT
        "and":    TOK_AND
        "or":     TOK_OR
        "match":  TOK_MATCH
        "_":      TOK_WILDCARD
        "fn":     TOK_FN
        "return": TOK_RETURN
        "void":   TOK_VOID
        "while":   TOK_WHILE
        "include": TOK_INCLUDE
        "as":      TOK_AS
        _:         TOK_IDENT
    }
}

fn readIdent(source String, pos Int64) Struct {
    let text String: ""
    while pos.lt(source.len()) and isLetterDigitUnderscore(source.at(pos)) {
        text: text.append(source.at(pos))
        pos: pos.add(1)
    }
    return { text String: text, pos Int64: pos }
}

fn readIdentOrKeyword(source String, pos Int64, line Int64, col Int64) Struct {
    let startCol Int64: col
    let r Struct: readIdent(source, pos)
    let kind Int64: keywordKind(r.text)
    let tok Struct: makeToken(kind, r.text, line, startCol)
    return { token Struct: tok, pos Int64: r.pos, line Int64: line, col Int64: col.add(r.text.len()) }
}

fn readDigits(source String, pos Int64) Struct {
    let text String: ""
    while pos.lt(source.len()) and isDigit(source.at(pos)) {
        text: text.append(source.at(pos))
        pos: pos.add(1)
    }
    return { text String: text, pos Int64: pos }
}

fn checkFloat(source String, pos Int64) Bool {
    let next Int64: pos.add(1)
    return pos.lt(source.len()) and source.at(pos).equals(".") and next.lt(source.len()) and isDigit(source.at(next))
}

fn makeFloatToken(intText String, source String, pos Int64, line Int64, startCol Int64, col Int64) Struct {
    pos: pos.add(1)
    col: col.add(1)
    let r2 Struct: readDigits(source, pos)
    let tok Struct: makeToken(TOK_FLOAT, intText.append(".").append(r2.text), line, startCol)
    return { token Struct: tok, pos Int64: r2.pos, line Int64: line, col Int64: col.add(r2.text.len()) }
}

fn makeIntToken(intText String, pos Int64, line Int64, startCol Int64, col Int64) Struct {
    let tok Struct: makeToken(TOK_INT, intText, line, startCol)
    return { token Struct: tok, pos Int64: pos, line Int64: line, col Int64: col }
}

fn readNumber(source String, pos Int64, line Int64, col Int64) Struct {
    let startCol Int64: col
    let r Struct: readDigits(source, pos)
    let intText String: r.text
    pos: r.pos
    col: col.add(intText.len())
    return match checkFloat(source, pos) {
        true: makeFloatToken(intText, source, pos, line, startCol, col)
        _:    makeIntToken(intText, pos, line, startCol, col)
    }
}

fn escapeChar(esc String) String {
    return match esc {
        "n":  "\n"
        "t":  "\t"
        "\\": "\\"
        "\"": "\""
        _:    esc
    }
}

fn readString(source String, pos Int64, line Int64, col Int64) Struct {
    let startCol Int64: col
    pos: pos.add(1)
    col: col.add(1)
    let text String: ""
    while pos.lt(source.len()) and not source.at(pos).equals("\"") {
        let isEscape Bool: source.at(pos).equals("\\") and pos.add(1).lt(source.len())
        let ch String: match isEscape { true: escapeChar(source.at(pos.add(1))), _: source.at(pos) }
        let skip Int64: match isEscape { true: 2, _: 1 }
        text: text.append(ch)
        pos: pos.add(skip)
        col: col.add(skip)
    }
    let advanced Int64: match pos.lt(source.len()) { true: 1, _: 0 }
    pos: pos.add(advanced)
    col: col.add(advanced)
    let tok Struct: makeToken(TOK_STRING, text, line, startCol)
    return { token Struct: tok, pos Int64: pos, line Int64: line, col Int64: col }
}

fn singleCharKind(ch String) Int64 {
    return match ch {
        "(":  TOK_LPAREN
        ")":  TOK_RPAREN
        ",":  TOK_COMMA
        ".":  TOK_DOT
        ":":  TOK_COLON
        "{":  TOK_LBRACE
        "}":  TOK_RBRACE
        "[":  TOK_LBRACKET
        "]":  TOK_RBRACKET
        "-":  TOK_MINUS
        "<":  TOK_LT
        ">":  TOK_GT
        _:    TOK_EOF
    }
}

fn processSingleChar(tokens Array<Struct>, ch String, pos Int64, line Int64, col Int64) Struct {
    let kind Int64: singleCharKind(ch)
    tokens.add(makeToken(kind, ch, line, col))
    return { pos Int64: pos.add(1), line Int64: line, col Int64: col.add(1) }
}

fn processStringToken(source String, tokens Array<Struct>, pos Int64, line Int64, col Int64) Struct {
    let r Struct: readString(source, pos, line, col)
    tokens.add(r.token)
    return { pos Int64: r.pos, line Int64: r.line, col Int64: r.col }
}

fn processNumberToken(source String, tokens Array<Struct>, pos Int64, line Int64, col Int64) Struct {
    let r Struct: readNumber(source, pos, line, col)
    tokens.add(r.token)
    return { pos Int64: r.pos, line Int64: r.line, col Int64: r.col }
}

fn processIdentToken(source String, tokens Array<Struct>, pos Int64, line Int64, col Int64) Struct {
    let r Struct: readIdentOrKeyword(source, pos, line, col)
    tokens.add(r.token)
    return { pos Int64: r.pos, line Int64: r.line, col Int64: r.col }
}

fn processSymbolOrString(source String, tokens Array<Struct>, ch String, pos Int64, line Int64, col Int64) Struct {
    return match ch.equals("\"") {
        true: processStringToken(source, tokens, pos, line, col)
        _:    processSingleChar(tokens, ch, pos, line, col)
    }
}

fn processNonWhitespace(source String, tokens Array<Struct>, ch String, pos Int64, line Int64, col Int64) Struct {
    return match isLetter(ch) or ch.equals("_") {
        true: processIdentToken(source, tokens, pos, line, col)
        _: match isDigit(ch) {
            true: processNumberToken(source, tokens, pos, line, col)
            _:    processSymbolOrString(source, tokens, ch, pos, line, col)
        }
    }
}

fn advanceWhitespace(ch String, pos Int64, line Int64, col Int64) Struct {
    let newLine Int64: match ch.equals("\n") { true: line.add(1), _: line }
    let newCol Int64: match ch.equals("\n") { true: 1, _: col.add(1) }
    return { pos Int64: pos.add(1), line Int64: newLine, col Int64: newCol }
}

fn tokenize(source String) Array<Struct> {
    let tokens Array<Struct>: []
    let pos Int64: 0
    let line Int64: 1
    let col Int64: 1

    while pos.lt(source.len()) {
        let ch String: source.at(pos)
        let st Struct: match isWhitespace(ch) {
            true: advanceWhitespace(ch, pos, line, col)
            _:    processNonWhitespace(source, tokens, ch, pos, line, col)
        }
        pos: st.pos
        line: st.line
        col: st.col
    }

    tokens.add(makeToken(TOK_EOF, "", line, col))
    return tokens
}
