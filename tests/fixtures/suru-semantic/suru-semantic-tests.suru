    let body Array<AstNode>: []
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "Int64", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// fn_bare_return_in_nonvoid_reports_error: Int64 function with bare return — 1 error.
// checkHasReturn finds the ReturnNode so "missing return" is suppressed;
// only the "bare return in non-void" error fires.
fn testFnBareReturnInNonvoidReportsError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body Array<AstNode>: []
    let dummy WildcardNode: {}
    let ret ReturnNode: { hasValue: false, value: dummy }
    body.add(ret)
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "Int64", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// fn_params_visible_in_scope: param x declared so assignment inside body is clean.
fn testFnParamsVisibleInScope() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body Array<AstNode>: []
    let intLit IntLitNode: { text: "0" }
    let assign AssignNode: { name: "x", value: intLit }
    body.add(assign)
    let params Array<Param>: []
    params.add({ name: "x", typeName: "Int64" })
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "void", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// fn_scope_not_leaked: let inside function body not visible after analyzeFunctionDeclaration.
fn testFnScopeNotLeaked() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body Array<AstNode>: []
    let intLit IntLitNode: { text: "0" }
    let innerLet LetNode: { name: "inner", typeName: "Int64", value: intLit }
    body.add(innerLet)
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "void", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let result String: semantic.lookupSymbol(state, "inner")
    return result.equals("")
}

// fn_return_in_while_counts: return inside a while body satisfies non-void requirement.
fn testFnReturnInWhileCounts() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let whileBody Array<AstNode>: []
    let intLit IntLitNode: { text: "0" }
    let ret ReturnNode: { hasValue: true, value: intLit }
    whileBody.add(ret)
    let body Array<AstNode>: []
    let cond BoolLitNode: { boolVal: true }
    let w WhileNode: { condition: cond, body: whileBody }
    body.add(w)
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "Int64", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}
