// assign_valid_no_error: assigning to a declared non-module-scope variable is clean.
fn testAssignValidNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.pushScope(state)
    let stmts Array<AstNode>: []
    let intLit1 IntLitNode: { text: "0" }
    let n1 LetNode: { name: "x", typeName: "Int64", value: intLit1 }
    stmts.add(n1)
    let intLit2 IntLitNode: { text: "0" }
    let n2 AssignNode: { name: "x", value: intLit2 }
    stmts.add(n2)
    analysis.analyzeStatements(state, stmts)
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// return_bare_in_nonvoid_reports_error: bare return in non-void gives 1 error.
fn testReturnBareInNonvoidReportsError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    state.currentReturnType: "Int64"
    let stmts Array<AstNode>: []
    let dummy WildcardNode: {}
    let n ReturnNode: { hasValue: false, value: dummy }
    stmts.add(n)
    analysis.analyzeStatements(state, stmts)
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// return_bare_in_void_no_error: bare return in void function produces no error.
fn testReturnBareInVoidNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    state.currentReturnType: "void"
    let stmts Array<AstNode>: []
    let dummy WildcardNode: {}
    let n ReturnNode: { hasValue: false, value: dummy }
    stmts.add(n)
    analysis.analyzeStatements(state, stmts)
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// while_scopes_do_not_leak: variable in while body not visible after loop.
fn testWhileScopesDoNotLeak() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body Array<AstNode>: []
    let intLit IntLitNode: { text: "0" }
    let innerLet LetNode: { name: "inner", typeName: "Int64", value: intLit }
    body.add(innerLet)
    let stmts Array<AstNode>: []
    let cond BoolLitNode: { boolVal: true }
    let n WhileNode: { condition: cond, body: body }
    stmts.add(n)
    analysis.analyzeStatements(state, stmts)
    let result String: semantic.lookupSymbol(state, "inner")
    return result.equals("")
}

// while_sequential_allow_same_name: same variable in two successive while bodies is fine.
fn testWhileSequentialAllowSameName() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body1 Array<AstNode>: []
    let intLit1 IntLitNode: { text: "0" }
    let let1 LetNode: { name: "i", typeName: "Int64", value: intLit1 }
    body1.add(let1)
    let body2 Array<AstNode>: []
    let intLit2 IntLitNode: { text: "0" }
    let let2 LetNode: { name: "i", typeName: "Int64", value: intLit2 }
    body2.add(let2)
    let stmts Array<AstNode>: []
    let cond1 BoolLitNode: { boolVal: true }
    let w1 WhileNode: { condition: cond1, body: body1 }
    stmts.add(w1)
    let cond2 BoolLitNode: { boolVal: true }
    let w2 WhileNode: { condition: cond2, body: body2 }
    stmts.add(w2)
    analysis.analyzeStatements(state, stmts)
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// ─── Stage 13d: function declaration analysis unit tests ─────────────────────

// fn_void_no_return_no_error: void function with empty body produces no error.
fn testFnVoidNoReturnNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body Array<AstNode>: []
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "doStuff", params: params, returnType: "void", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// fn_nonvoid_has_return_no_error: Int64 function with a return statement — no error.
fn testFnNonvoidHasReturnNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let body Array<AstNode>: []
    let intLit IntLitNode: { text: "0" }
    let ret ReturnNode: { hasValue: true, value: intLit }
    body.add(ret)
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "Int64", body: body }
    stmts.add(n)
    passes.runPrePasses(state, stmts)
    fns.analyzeFunctionDeclaration(state, stmts.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// fn_nonvoid_missing_return_reports_error: Int64 function with empty body — 1 error.
fn testFnNonvoidMissingReturnReportsError() Bool {
