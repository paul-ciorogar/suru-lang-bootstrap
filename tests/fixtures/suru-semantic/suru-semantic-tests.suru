// Stage 13a–13d unit test functions — extracted from main.suru so that the
// main.suru driver can stay under 500 lines while Stage 13e tests are added.
//
// All test functions return Bool and are called from main.suru via the `t`
// namespace alias. This file includes the semantic analyzer files directly so
// the same namespace aliases are available inside the test bodies.
//
// AstNode is now a sum type — test nodes are created via typed let bindings:
//   let n FnDeclNode: { name: ..., params: ..., returnType: ..., body: ... }
//   stmts.add(n)
// The variant ptr is stored in the Array<AstNode>; analyzeStatement dispatches
// via match stmt { FnDeclNode: ... } using @suru_variant_tag.
//
// After Stage 13e wired expression analysis into all statement analyzers,
// test AstNodes for statements that carry an expression must include valid
// AstNode values for the expression fields:
//
//   LetNode    → value: IntLitNode { text: "0" }
//   AssignNode → value: IntLitNode { text: "0" }
//   WhileNode  → condition: BoolLitNode { boolVal: true }
//   ReturnNode { hasValue: true } → value: IntLitNode { text: "0" }
//     (inferType returns "Int64" for IntLitNode; matches "Int64" return type
//      so no spurious return-type-mismatch error is produced)
//   ReturnNode { hasValue: false } → value: WildcardNode {} (never accessed)

include "suru-semantic.suru" as semantic
include "suru-semantic-passes.suru" as passes
include "suru-semantic-stmts.suru" as analysis
include "suru-semantic-fns.suru" as fns

// ─── Stage 13a: scope-chain unit tests ───────────────────────────────────────

fn testPushPopRoundtrip() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.pushScope(state)
    semantic.pushScope(state)
    semantic.pushScope(state)
    let s1 Array<Scope>: state.scopes
    let afterPush Bool: s1.len().equals(4)
    semantic.popScope(state)
    semantic.popScope(state)
    semantic.popScope(state)
    let s2 Array<Scope>: state.scopes
    let afterPop Bool: s2.len().equals(1)
    return afterPush and afterPop
}

fn testLookupFindsNearest() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.declareSymbol(state, "x", "Int64")
    semantic.pushScope(state)
    semantic.declareSymbol(state, "x", "Bool")
    let result String: semantic.lookupSymbol(state, "x")
    return result.equals("Bool")
}

fn testLookupWalksParent() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.declareSymbol(state, "y", "String")
    semantic.pushScope(state)
    semantic.pushScope(state)
    let result String: semantic.lookupSymbol(state, "y")
    return result.equals("String")
}

fn testLookupReturnsEmpty() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let result String: semantic.lookupSymbol(state, "undeclared")
    return result.equals("")
}

fn testAddError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.addError(state, "error one")
    semantic.addError(state, "error two")
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(2)
}

// ─── Stage 13b: declaration pre-pass unit tests ───────────────────────────────

fn testResolveTypeNameBuiltin() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let r1 Bool: passes.resolveTypeName(state, "Int64")
    let r2 Bool: passes.resolveTypeName(state, "Bool")
    let r3 Bool: passes.resolveTypeName(state, "String")
    let r4 Bool: passes.resolveTypeName(state, "Float64")
    let r5 Bool: passes.resolveTypeName(state, "Array")
    let r6 Bool: passes.resolveTypeName(state, "Unknown")
    return r1 and r2 and r3 and r4 and r5 and not r6
}

fn testResolveTypeNameUserDeclared() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let typeNames Array<String>: state.typeNames
    typeNames.add("MyType")
    let r1 Bool: passes.resolveTypeName(state, "MyType")
    let r2 Bool: passes.resolveTypeName(state, "OtherType")
    return r1 and not r2
}

// collectTypeDecls_registers: two TypeDeclNode stmts populate typeNames; no errors.
fn testCollectTypeDeclsRegisters() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let stmts Array<AstNode>: []
    let n1 TypeDeclNode: { name: "Foo", fields: [] }
    stmts.add(n1)
    let n2 TypeDeclNode: { name: "Bar", fields: [] }
    stmts.add(n2)
    let letLit IntLitNode: { text: "0" }
    let n3 LetNode: { name: "x", typeName: "Int64", value: letLit }
    stmts.add(n3)
    passes.collectTypeDeclarations(state, stmts)
    let typeNames Array<String>: state.typeNames
    let errors Array<AnalysisError>: state.errors
    return typeNames.len().equals(2) and errors.len().equals(0)
}

// collectTypeDecls_duplicate: duplicate name produces exactly one error.
fn testCollectTypeDeclsDuplicate() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let stmts Array<AstNode>: []
    let n1 TypeDeclNode: { name: "Foo", fields: [] }
    stmts.add(n1)
    let n2 TypeDeclNode: { name: "Foo", fields: [] }
    stmts.add(n2)
    passes.collectTypeDeclarations(state, stmts)
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// collectFnDecls_registers: one FnDeclNode with valid param type registers cleanly.
fn testCollectFnDeclsRegisters() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let params Array<Param>: []
    params.add({ name: "x", typeName: "Int64" })
    let stmts Array<AstNode>: []
    let body Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "Bool", body: body }
    stmts.add(n)
    passes.collectFunctionDeclarations(state, stmts)
    let functions Array<FunctionSig>: state.functions
    let errors Array<AnalysisError>: state.errors
    return functions.len().equals(1) and errors.len().equals(0)
}

// collectFnDecls_duplicate: same function name twice produces exactly one error.
fn testCollectFnDeclsDuplicate() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let params Array<Param>: []
    let stmts Array<AstNode>: []
    let body Array<AstNode>: []
    let n1 FnDeclNode: { name: "myFn", params: params, returnType: "void", body: body }
    stmts.add(n1)
    let n2 FnDeclNode: { name: "myFn", params: params, returnType: "void", body: body }
    stmts.add(n2)
    passes.collectFunctionDeclarations(state, stmts)
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// collectFnDecls_unknown_param: unknown param type produces exactly one error.
fn testCollectFnDeclsUnknownParam() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let params Array<Param>: []
    params.add({ name: "x", typeName: "UnknownType" })
    let stmts Array<AstNode>: []
    let body Array<AstNode>: []
    let n FnDeclNode: { name: "myFn", params: params, returnType: "void", body: body }
    stmts.add(n)
    passes.collectFunctionDeclarations(state, stmts)
