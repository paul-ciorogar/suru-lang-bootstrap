// Stage 13a–13e integration test driver.
//
// Thin entry point: test functions live in suru-semantic-tests.suru (stages
// 13a–13d) and below (stage 13e). Called via namespace `t` or locally.
//
// Stage 13e (this file) tests:
//   inferType — type inference for literals, variable refs, method calls
//   analyzeExpr — undefined variable errors, function arity errors, builtins

include "suru-semantic.suru" as semantic
include "suru-semantic-passes.suru" as passes
include "suru-semantic-stmts.suru" as analysis
include "suru-semantic-fns.suru" as fns
include "suru-semantic-exprs.suru" as exprs
include "suru-semantic-tests.suru" as t

// ─── Test harness ─────────────────────────────────────────────────────────────

fn passOrFail(name String, result Bool) {
    match result {
        true: printLn("PASS: ".append(name))
        _: printLn("FAIL: ".append(name))
    }
}

// ─── Stage 13e: expression analysis unit tests ───────────────────────────────
//
// inferType and analyzeExpr are called via the `exprs` namespace.
// AstNode test nodes use the undeclared-field pattern: extra fields are added
// via array.add() or struct literals and accessed by suru_find_field at runtime.

// ─── Stage 13e helpers ────────────────────────────────────────────────────────
//
// AstNode is declared as { kind Int64 } — only one field. Extra fields (name,
// methodName, receiver, args) are added via array.add() call-argument literals
// to bypass ValidateStructLiteralFields, the same pattern used in stages 13b–13d.

// makeExprNode — constructs a single-field { kind } AstNode using a let binding.
// Only usable for expressions whose inferType/analyzeExpr only reads kind.
// For nodes with extra fields (VAR_REF, METHOD_CALL, CALL), use push1/push4 helpers.
fn push1Node(buf Array<AstNode>, kind Int64) {
    buf.add({ kind: kind })
}

fn pushVarRef(buf Array<AstNode>, name String) {
    buf.add({ kind: NODE_VAR_REF, name: name })
}

fn pushCallNode(buf Array<AstNode>, name String, args Array<AstNode>) {
    buf.add({ kind: NODE_CALL, name: name, args: args })
}

fn pushMethodCallNode(buf Array<AstNode>, methodName String, rcv AstNode, args Array<AstNode>) {
    buf.add({ kind: NODE_METHOD_CALL, methodName: methodName, receiver: rcv, args: args })
}

// ─── inferType unit tests ─────────────────────────────────────────────────────

// inferType_bool_literal: NODE_BOOL_LIT → "Bool".
fn testInferTypeBoolLiteral() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    push1Node(buf, NODE_BOOL_LIT)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("Bool")
}

// inferType_int_literal: NODE_INT_LIT → "Int64".
fn testInferTypeIntLiteral() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    push1Node(buf, NODE_INT_LIT)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("Int64")
}

// inferType_float_literal: NODE_FLOAT_LIT → "Float64".
fn testInferTypeFloatLiteral() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    push1Node(buf, NODE_FLOAT_LIT)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("Float64")
}

// inferType_str_literal: NODE_STR_LIT → "String".
fn testInferTypeStrLiteral() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    push1Node(buf, NODE_STR_LIT)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("String")
}

// inferType_var_ref: declared variable → its declared type name.
fn testInferTypeVarRef() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.declareSymbol(state, "x", "Int64")
    let buf Array<AstNode>: []
    pushVarRef(buf, "x")
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("Int64")
}

// inferType_method_call_equals: methodName "equals" → "Bool".
fn testInferTypeMethodCallEquals() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let rcvBuf Array<AstNode>: []
    push1Node(rcvBuf, NODE_BOOL_LIT)
    let args Array<AstNode>: []
    let buf Array<AstNode>: []
    pushMethodCallNode(buf, "equals", rcvBuf.at(0), args)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("Bool")
}

// inferType_method_call_len: methodName "len" → "Int64".
fn testInferTypeMethodCallLen() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let rcvBuf Array<AstNode>: []
    push1Node(rcvBuf, NODE_INT_LIT)
    let args Array<AstNode>: []
    let buf Array<AstNode>: []
    pushMethodCallNode(buf, "len", rcvBuf.at(0), args)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("Int64")
}

// inferType_unknown_kind_returns_empty: kind 0 (no match) → "".
fn testInferTypeUnknownReturnsEmpty() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    push1Node(buf, 0)
    let result String: exprs.inferType(state, buf.at(0))
    return result.equals("")
}

// ─── analyzeExpr unit tests ───────────────────────────────────────────────────

// analyzeExpr_undefined_var_reports_error: NODE_VAR_REF with unknown name → 1 error.
fn testAnalyzeExprUndefinedVar() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    pushVarRef(buf, "undeclared")
    exprs.analyzeExpr(state, buf.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// analyzeExpr_defined_var_no_error: NODE_VAR_REF with declared name → 0 errors.
fn testAnalyzeExprDefinedVarNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    semantic.declareSymbol(state, "x", "Int64")
    let buf Array<AstNode>: []
    pushVarRef(buf, "x")
    exprs.analyzeExpr(state, buf.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// analyzeExpr_builtin_type_var_no_error: NODE_VAR_REF with builtin type name (static
// receiver like Int64) is not an error even though it is not declared in scope.
fn testAnalyzeExprBuiltinTypeVarNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let buf Array<AstNode>: []
    pushVarRef(buf, "Int64")
    exprs.analyzeExpr(state, buf.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// analyzeExpr_fn_arity_mismatch_reports_error: NODE_CALL to a registered function with
// wrong arg count → 1 error.
fn testAnalyzeExprFnArityMismatch() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    // Register a function that takes 1 param.
    let params Array<Param>: []
    params.add({ name: "x", typeName: "Int64" })
    let decls Array<AstNode>: []
    decls.add({ kind: NODE_FN_DECL, name: "myFn", params: params, returnType: "void" })
    passes.runPrePasses(state, decls)
    // Call myFn with 0 args — arity mismatch.
    let args Array<AstNode>: []
    let callBuf Array<AstNode>: []
    pushCallNode(callBuf, "myFn", args)
    exprs.analyzeExpr(state, callBuf.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// analyzeExpr_fn_arity_correct_no_error: NODE_CALL with matching arg count → 0 errors.
fn testAnalyzeExprFnArityCorrectNoError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let params Array<Param>: []
    params.add({ name: "x", typeName: "Int64" })
    let decls Array<AstNode>: []
    decls.add({ kind: NODE_FN_DECL, name: "myFn", params: params, returnType: "void" })
    passes.runPrePasses(state, decls)
    // Call myFn with 1 arg — correct arity.
    let args Array<AstNode>: []
    args.add({ kind: NODE_INT_LIT })
    let callBuf Array<AstNode>: []
    pushCallNode(callBuf, "myFn", args)
    exprs.analyzeExpr(state, callBuf.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(0)
}

// analyzeExpr_builtin_arity_error: printLn with 0 args → 1 error.
fn testAnalyzeExprBuiltinArityError() Bool {
    let state AnalyzerState: semantic.makeAnalyzerState()
    let args Array<AstNode>: []
    let callBuf Array<AstNode>: []
    pushCallNode(callBuf, "printLn", args)
    exprs.analyzeExpr(state, callBuf.at(0))
    let errors Array<AnalysisError>: state.errors
    return errors.len().equals(1)
}

// ─── Entry point ─────────────────────────────────────────────────────────────

fn main(args Array<String>) {
    // Stage 13a — scope-chain helpers
    passOrFail("push_pop_roundtrip",       t.testPushPopRoundtrip())
    passOrFail("lookup_finds_nearest",     t.testLookupFindsNearest())
    passOrFail("lookup_walks_parent",      t.testLookupWalksParent())
    passOrFail("lookup_returns_empty",     t.testLookupReturnsEmpty())
    passOrFail("add_error",                t.testAddError())

    // Stage 13b — declaration pre-passes
    passOrFail("resolveTypeName_builtin",       t.testResolveTypeNameBuiltin())
    passOrFail("resolveTypeName_user_declared", t.testResolveTypeNameUserDeclared())
    passOrFail("collectTypeDecls_registers",    t.testCollectTypeDeclsRegisters())
    passOrFail("collectTypeDecls_duplicate",    t.testCollectTypeDeclsDuplicate())
    passOrFail("collectFnDecls_registers",      t.testCollectFnDeclsRegisters())
    passOrFail("collectFnDecls_duplicate",      t.testCollectFnDeclsDuplicate())
    passOrFail("collectFnDecls_unknown_param",  t.testCollectFnDeclsUnknownParam())
    passOrFail("runPrePasses_cross_pass",       t.testRunPrePassesCrossPass())

    // Stage 13c — statement analysis
    passOrFail("let_declares_symbol",                  t.testLetDeclaresSymbol())
    passOrFail("let_duplicate_in_scope_reports_error", t.testLetDuplicateInScopeReportsError())
    passOrFail("let_unknown_type_reports_error",       t.testLetUnknownTypeReportsError())
    passOrFail("let_at_module_scope_is_constant",      t.testLetAtModuleScopeIsConstant())
    passOrFail("assign_undefined_reports_error",       t.testAssignUndefinedReportsError())
    passOrFail("assign_constant_reports_error",        t.testAssignConstantReportsError())
    passOrFail("assign_valid_no_error",                t.testAssignValidNoError())
    passOrFail("return_bare_in_nonvoid_reports_error", t.testReturnBareInNonvoidReportsError())
    passOrFail("return_bare_in_void_no_error",         t.testReturnBareInVoidNoError())
    passOrFail("while_scopes_do_not_leak",             t.testWhileScopesDoNotLeak())
    passOrFail("while_sequential_allow_same_name",     t.testWhileSequentialAllowSameName())

    // Stage 13d — function declaration analysis
    passOrFail("fn_void_no_return_no_error",              t.testFnVoidNoReturnNoError())
    passOrFail("fn_nonvoid_has_return_no_error",          t.testFnNonvoidHasReturnNoError())
    passOrFail("fn_nonvoid_missing_return_reports_error", t.testFnNonvoidMissingReturnReportsError())
    passOrFail("fn_bare_return_in_nonvoid_reports_error", t.testFnBareReturnInNonvoidReportsError())
    passOrFail("fn_params_visible_in_scope",              t.testFnParamsVisibleInScope())
    passOrFail("fn_scope_not_leaked",                     t.testFnScopeNotLeaked())
    passOrFail("fn_return_in_while_counts",               t.testFnReturnInWhileCounts())

    // Stage 13e — expression analysis
    passOrFail("inferType_bool_literal",           testInferTypeBoolLiteral())
    passOrFail("inferType_int_literal",            testInferTypeIntLiteral())
    passOrFail("inferType_float_literal",          testInferTypeFloatLiteral())
    passOrFail("inferType_str_literal",            testInferTypeStrLiteral())
    passOrFail("inferType_var_ref",                testInferTypeVarRef())
    passOrFail("inferType_method_call_equals",     testInferTypeMethodCallEquals())
    passOrFail("inferType_method_call_len",        testInferTypeMethodCallLen())
    passOrFail("inferType_unknown_returns_empty",  testInferTypeUnknownReturnsEmpty())
    passOrFail("analyzeExpr_undefined_var_reports_error",    testAnalyzeExprUndefinedVar())
    passOrFail("analyzeExpr_defined_var_no_error",           testAnalyzeExprDefinedVarNoError())
    passOrFail("analyzeExpr_builtin_type_var_no_error",      testAnalyzeExprBuiltinTypeVarNoError())
    passOrFail("analyzeExpr_fn_arity_mismatch_reports_error", testAnalyzeExprFnArityMismatch())
    passOrFail("analyzeExpr_fn_arity_correct_no_error",      testAnalyzeExprFnArityCorrectNoError())
    passOrFail("analyzeExpr_builtin_arity_error",            testAnalyzeExprBuiltinArityError())
}
