include "../suru-lexer/suru-lexer.suru" as lexer

type Parser:        { pos Int64, tokens Array<Token> }
type AstNode:       { kind Int64 }
type Param:         { name String, typeName String }
type MatchArm:      { kind Int64, isWildcard Bool, pattern AstNode, body AstNode }
type AstModule:     { stmts Array<AstNode> }
type ParseResult:   { parser Parser, expr AstNode }
type TypeAnnResult: { parser Parser, typeName String }
type RetTypeResult: { parser Parser, returnType String }
type ArgsResult:    { parser Parser, args Array<AstNode> }
type ArmResult:     { parser Parser, arm MatchArm }
type PatResult:     { parser Parser, pat AstNode }
type StmtResult:    { parser Parser, stmt AstNode }

let TOK_EOF      Int64: 0
let TOK_IDENT    Int64: 1
let TOK_TRUE     Int64: 2
let TOK_FALSE    Int64: 3
let TOK_INT      Int64: 4
let TOK_FLOAT    Int64: 5
let TOK_STRING   Int64: 6
let TOK_LPAREN   Int64: 7
let TOK_RPAREN   Int64: 8
let TOK_COMMA    Int64: 9
let TOK_DOT      Int64: 10
let TOK_COLON    Int64: 11
let TOK_LBRACE   Int64: 12
let TOK_RBRACE   Int64: 13
let TOK_LBRACKET Int64: 14
let TOK_RBRACKET Int64: 15
let TOK_LET      Int64: 16
let TOK_NOT      Int64: 17
let TOK_AND      Int64: 18
let TOK_OR       Int64: 19
let TOK_MATCH    Int64: 20
let TOK_WILDCARD Int64: 21
let TOK_FN       Int64: 22
let TOK_RETURN   Int64: 23
let TOK_VOID     Int64: 24
let TOK_MINUS    Int64: 25
let TOK_WHILE    Int64: 26
let TOK_LT       Int64: 27
let TOK_GT       Int64: 28
let TOK_INCLUDE  Int64: 29
let TOK_AS       Int64: 30
let TOK_TYPE     Int64: 31

let NODE_INCLUDE      Int64: 1
let NODE_FN_DECL      Int64: 2
let NODE_LET          Int64: 3
let NODE_ASSIGN       Int64: 4
let NODE_FIELD_ASSIGN Int64: 5
let NODE_RETURN       Int64: 6
let NODE_WHILE        Int64: 7
let NODE_EXPR_STMT    Int64: 8
let NODE_TYPE_DECL    Int64: 9

let NODE_BOOL_LIT     Int64: 10
let NODE_INT_LIT      Int64: 11
let NODE_FLOAT_LIT    Int64: 12
let NODE_STR_LIT      Int64: 13
let NODE_VAR_REF      Int64: 14
let NODE_CALL         Int64: 15
let NODE_METHOD_CALL  Int64: 16
let NODE_FIELD_ACCESS Int64: 17
let NODE_ARRAY_LIT    Int64: 18
let NODE_STRUCT_LIT   Int64: 19
let NODE_MATCH        Int64: 20
let NODE_UNARY        Int64: 21
let NODE_BINARY       Int64: 22
let NODE_STRUCT_FIELD Int64: 23
let NODE_MATCH_ARM    Int64: 24

let OP_NOT Int64: 1
let OP_AND Int64: 2
let OP_OR  Int64: 3

fn currentToken(parser Parser) Token {
    return parser.tokens.at(parser.pos)
}

fn currentTokenIs(parser Parser, kind Int64) Bool {
    return parser.tokens.at(parser.pos).kind.equals(kind)
}

fn peekToken(parser Parser) Token {
    let next Int64: parser.pos.add(1)
    return match next.lt(parser.tokens.len()) {
        true: parser.tokens.at(next)
        _:    { kind: 0, text: "", line: 0, col: 0 }
    }
}

fn peekIs(parser Parser, kind Int64) Bool {
    return peekToken(parser).kind.equals(kind)
}

fn advance(parser Parser) Parser {
    parser.pos: parser.pos.add(1)
    return parser
}

fn consume(parser Parser, expectedKind Int64) Parser {
    match not currentTokenIs(parser, expectedKind) {
        true: error(parser, "expected token kind ".append(expectedKind.toString()).append(" got ").append(currentToken(parser).kind.toString()).append(" '").append(currentToken(parser).text).append("'"))
    }
    return advance(parser)
}

fn consumeIf(parser Parser, kind Int64) Parser {
    return match currentTokenIs(parser, kind) {
        true: advance(parser)
        _:    parser
    }
}

fn error(parser Parser, msg String) Parser {
    let tok Token: currentToken(parser)
    printError(msg.append(" at ").append(tok.line.toString()).append(":").append(tok.col.toString()))
    exit(1)
}

fn parseTypeAnnotation(parser Parser) TypeAnnResult {
    let tok Token: currentToken(parser)
    match not tok.kind.equals(TOK_IDENT) {
        true: error(parser, "expected type name")
    }
    let name String: tok.text
    parser: advance(parser)
    return match currentTokenIs(parser, TOK_LT) {
        true: parseGenericTypeAnnotation(parser, name)
        _:    { parser: parser, typeName: name }
    }
}

fn parseGenericTypeAnnotation(parser Parser, name String) TypeAnnResult {
    parser: advance(parser)
    let inner TypeAnnResult: parseTypeAnnotation(parser)
    parser: inner.parser
    let fullName String: name.append("<").append(inner.typeName).append(">")
    inner.parser: {}
    drop(inner)
    parser: consume(parser, TOK_GT)
    return { parser: parser, typeName: fullName }
}

fn parseExpr(parser Parser) ParseResult {
    return parseOrExpr(parser)
}

fn parseOrExpr(parser Parser) ParseResult {
    let lr ParseResult: parseAndExpr(parser)
    parser: lr.parser
    let left AstNode: lr.expr
    lr.parser: {}
    lr.expr:   {}
    drop(lr)
    while currentTokenIs(parser, TOK_OR) {
        parser: advance(parser)
        let rr ParseResult: parseAndExpr(parser)
        parser: rr.parser
        let right AstNode: rr.expr
        rr.parser: {}
        rr.expr:   {}
        drop(rr)
        left: { kind: NODE_BINARY, op: OP_OR, left: left, right: right }
    }
    return { parser: parser, expr: left }
}

fn parseAndExpr(parser Parser) ParseResult {
    let lr ParseResult: parseNotExpr(parser)
    parser: lr.parser
    let left AstNode: lr.expr
    lr.parser: {}
    lr.expr:   {}
    drop(lr)
    while currentTokenIs(parser, TOK_AND) {
        parser: advance(parser)
        let rr ParseResult: parseNotExpr(parser)
        parser: rr.parser
        let right AstNode: rr.expr
        rr.parser: {}
        rr.expr:   {}
        drop(rr)
        left: { kind: NODE_BINARY, op: OP_AND, left: left, right: right }
    }
    return { parser: parser, expr: left }
}

fn parseNotExpr(parser Parser) ParseResult {
    return match currentTokenIs(parser, TOK_NOT) {
        true: parseNotExprBody(advance(parser))
        _:    parsePostfixChain(parser, parsePrimary(parser))
    }
}

fn parseNotExprBody(parser Parser) ParseResult {
    let r ParseResult: parseNotExpr(parser)
    parser: r.parser
    let inner AstNode: r.expr
    r.parser: {}
    r.expr:   {}
    drop(r)
    return { parser: parser, expr: { kind: NODE_UNARY, op: OP_NOT, operand: inner } }
}

fn parsePostfixChain(parser Parser, pr ParseResult) ParseResult {
    parser: pr.parser
    let expr AstNode: pr.expr
    pr.parser: {}
    pr.expr:   {}
    drop(pr)
    while currentTokenIs(parser, TOK_DOT) {
        let step ParseResult: processPostfixStep(parser, expr)
        parser: step.parser
        expr: step.expr
        step.parser: {}
        step.expr:   {}
        drop(step)
    }
    return { parser: parser, expr: expr }
}

fn processPostfixStep(parser Parser, expr AstNode) ParseResult {
    parser: advance(parser)
    let nameTok Token: currentToken(parser)
    parser: consume(parser, TOK_IDENT)
    let memberName String: nameTok.text
    return match currentTokenIs(parser, TOK_LPAREN) {
        true: parseMethodCallPart(parser, expr, memberName)
        _:    { parser: parser, expr: { kind: NODE_FIELD_ACCESS, receiver: expr, fieldName: memberName } }
    }
}

fn parseMethodCallPart(parser Parser, expr AstNode, memberName String) ParseResult {
    parser: advance(parser)
    let ar ArgsResult: parseArgs(parser)
    parser: ar.parser
    let args Array<AstNode>: ar.args
    ar.parser: {}
    ar.args:   {}
    drop(ar)
    parser: consume(parser, TOK_RPAREN)
    return { parser: parser, expr: { kind: NODE_METHOD_CALL, receiver: expr, methodName: memberName, args: args } }
}

fn parsePrimary(parser Parser) ParseResult {
    let tok Token: currentToken(parser)
    let k Int64: tok.kind
    return match k {
        TOK_LBRACKET: parsePrimaryArray(parser)
        TOK_LBRACE:   parsePrimaryStruct(parser)
        TOK_MATCH:    parsePrimaryMatch(parser)
        TOK_IDENT:    parsePrimaryIdent(parser, tok)
        TOK_MINUS:    parsePrimaryMinus(parser)
        TOK_TRUE:     { parser: advance(parser), expr: { kind: NODE_BOOL_LIT, value: true } }
        TOK_FALSE:    { parser: advance(parser), expr: { kind: NODE_BOOL_LIT, value: false } }
        TOK_INT:      { parser: advance(parser), expr: { kind: NODE_INT_LIT, text: tok.text } }
        TOK_FLOAT:    { parser: advance(parser), expr: { kind: NODE_FLOAT_LIT, text: tok.text } }
        TOK_STRING:   { parser: advance(parser), expr: { kind: NODE_STR_LIT, text: tok.text } }
        _:            error(parser, "unexpected token in expression")
    }
}

fn parsePrimaryArray(parser Parser) ParseResult {
    parser: advance(parser)
    let elems Array<AstNode>: []
    while not currentTokenIs(parser, TOK_RBRACKET) and not currentTokenIs(parser, TOK_EOF) {
        let er ParseResult: parseExpr(parser)
        parser: er.parser
        elems.add(er.expr)
        er.parser: {}
        er.expr:   {}
        drop(er)
        parser: consumeIf(parser, TOK_COMMA)
    }
    parser: consume(parser, TOK_RBRACKET)
    return { parser: parser, expr: { kind: NODE_ARRAY_LIT, count: elems.len(), elems: elems } }
}

fn parsePrimaryStruct(parser Parser) ParseResult {
    parser: advance(parser)
    let fields Array<AstNode>: []
    while not currentTokenIs(parser, TOK_RBRACE) and not currentTokenIs(parser, TOK_EOF) {
        let fieldNameTok Token: currentToken(parser)
        parser: consume(parser, TOK_IDENT)
        parser: consume(parser, TOK_COLON)
        let vr ParseResult: parseExpr(parser)
        parser: vr.parser
        let val AstNode: vr.expr
        vr.parser: {}
        vr.expr:   {}
        drop(vr)
        fields.add({ kind: NODE_STRUCT_FIELD, name: fieldNameTok.text, value: val })
        parser: consumeIf(parser, TOK_COMMA)
    }
    parser: consume(parser, TOK_RBRACE)
    return { parser: parser, expr: { kind: NODE_STRUCT_LIT, count: fields.len(), fields: fields } }
}

fn parsePrimaryMatch(parser Parser) ParseResult {
    parser: advance(parser)
    let cr ParseResult: parseExpr(parser)
    parser: cr.parser
    let cond AstNode: cr.expr
    cr.parser: {}
    cr.expr:   {}
    drop(cr)
    parser: consume(parser, TOK_LBRACE)
    let arms Array<AstNode>: []
    while not currentTokenIs(parser, TOK_RBRACE) and not currentTokenIs(parser, TOK_EOF) {
        let armR ArmResult: parseMatchArm(parser)
        parser: armR.parser
        arms.add(armR.arm)
        armR.parser: {}
        armR.arm:    {}
        drop(armR)
        parser: consumeIf(parser, TOK_COMMA)
    }
    parser: consume(parser, TOK_RBRACE)
    return { parser: parser, expr: { kind: NODE_MATCH, count: arms.len(), condition: cond, arms: arms } }
}

fn parsePrimaryIdent(parser Parser, tok Token) ParseResult {
    let name String: tok.text
    parser: advance(parser)
    return match currentTokenIs(parser, TOK_LPAREN) {
        true: parsePrimaryCall(parser, name)
        _:    { parser: parser, expr: { kind: NODE_VAR_REF, name: name } }
    }
}

fn parsePrimaryCall(parser Parser, name String) ParseResult {
    parser: advance(parser)
    let ar ArgsResult: parseArgs(parser)
    parser: ar.parser
    let args Array<AstNode>: ar.args
    ar.parser: {}
    ar.args:   {}
    drop(ar)
    parser: consume(parser, TOK_RPAREN)
    return { parser: parser, expr: { kind: NODE_CALL, name: name, args: args } }
}

fn parsePrimaryMinus(parser Parser) ParseResult {
    parser: advance(parser)
    let numTok Token: currentToken(parser)
    let k Int64: numTok.kind
    return match k {
        TOK_INT:   { parser: advance(parser), expr: { kind: NODE_INT_LIT, text: "-".append(numTok.text) } }
        TOK_FLOAT: { parser: advance(parser), expr: { kind: NODE_FLOAT_LIT, text: "-".append(numTok.text) } }
        _:         error(parser, "expected number after '-'")
    }
}

fn parseMatchArm(parser Parser) ArmResult {
    let patR PatResult: parseMatchPattern(parser)
    parser: patR.parser
    let pat AstNode: patR.pat
    patR.parser: {}
    patR.pat:    {}
    drop(patR)
    parser: consume(parser, TOK_COLON)
    let br ParseResult: parseExpr(parser)
    parser: br.parser
    let body AstNode: br.expr
    br.parser: {}
    br.expr:   {}
    drop(br)
    return { parser: parser, arm: { kind: NODE_MATCH_ARM, isWildcard: pat.kind.equals(0), pattern: pat, body: body } }
}

fn parseMatchPattern(parser Parser) PatResult {
    let tok Token: currentToken(parser)
    let k Int64: tok.kind
    return match k {
        TOK_WILDCARD: { parser: advance(parser), pat: { kind: 0 } }
        TOK_TRUE:     { parser: advance(parser), pat: { kind: NODE_BOOL_LIT, value: true } }
        TOK_FALSE:    { parser: advance(parser), pat: { kind: NODE_BOOL_LIT, value: false } }
        TOK_INT:      { parser: advance(parser), pat: { kind: NODE_INT_LIT, text: tok.text } }
        TOK_FLOAT:    { parser: advance(parser), pat: { kind: NODE_FLOAT_LIT, text: tok.text } }
        TOK_STRING:   { parser: advance(parser), pat: { kind: NODE_STR_LIT, text: tok.text } }
        TOK_MINUS:    parseNegativePattern(parser)
        TOK_IDENT:    { parser: advance(parser), pat: { kind: NODE_VAR_REF, name: tok.text } }
        _:            error(parser, "expected match pattern")
    }
}

fn parseNegativePattern(parser Parser) PatResult {
    parser: advance(parser)
    let num Token: currentToken(parser)
    let k Int64: num.kind
    return match k {
        TOK_INT:   { parser: advance(parser), pat: { kind: NODE_INT_LIT, text: "-".append(num.text) } }
        TOK_FLOAT: { parser: advance(parser), pat: { kind: NODE_FLOAT_LIT, text: "-".append(num.text) } }
        _:         error(parser, "expected number after '-' in match pattern")
    }
}

fn parseArgs(parser Parser) ArgsResult {
    return match currentTokenIs(parser, TOK_RPAREN) {
        true: { parser: parser, args: [] }
        _:    parseArgsList(parser)
    }
}

fn parseArgsList(parser Parser) ArgsResult {
    let args Array<AstNode>: []
    let er ParseResult: parseExpr(parser)
    parser: er.parser
    args.add(er.expr)
    er.parser: {}
    er.expr:   {}
    drop(er)
    while currentTokenIs(parser, TOK_COMMA) {
        parser: advance(parser)
        let er2 ParseResult: parseExpr(parser)
        parser: er2.parser
        args.add(er2.expr)
        er2.parser: {}
        er2.expr:   {}
        drop(er2)
    }
    return { parser: parser, args: args }
}

fn parseStatement(parser Parser) StmtResult {
    let k Int64: currentToken(parser).kind
    return match k {
        TOK_INCLUDE: parseIncludeDirective(parser)
        TOK_FN:      parseFnDecl(parser)
        TOK_WHILE:   parseWhileStmt(parser)
        TOK_RETURN:  parseReturnStmt(parser)
        TOK_LET:     parseLetStmt(parser)
        TOK_TYPE:    parseTypeDeclaration(parser)
        TOK_IDENT:   parseIdentStmt(parser)
        _:           parseExprStmt(parser)
    }
}

fn parseIncludeDirective(parser Parser) StmtResult {
    parser: consume(parser, TOK_INCLUDE)
    let pathTok Token: currentToken(parser)
    parser: consume(parser, TOK_STRING)
    parser: consume(parser, TOK_AS)
    let nsTok Token: currentToken(parser)
    parser: consume(parser, TOK_IDENT)
    return { parser: parser, stmt: { kind: NODE_INCLUDE, path: clone(pathTok.text), ns: clone(nsTok.text) } }
}

fn parseFnDecl(parser Parser) StmtResult {
    parser: consume(parser, TOK_FN)
    let nameTok Token: currentToken(parser)
    parser: consume(parser, TOK_IDENT)
    parser: consume(parser, TOK_LPAREN)
    let params Array<Param>: []
    while not currentTokenIs(parser, TOK_RPAREN) and not currentTokenIs(parser, TOK_EOF) {
        let pNameTok Token: currentToken(parser)
        parser: consume(parser, TOK_IDENT)
        let tr TypeAnnResult: parseTypeAnnotation(parser)
        parser: tr.parser
        let pType String: tr.typeName
        tr.parser: {}
        drop(tr)
        params.add({ name: pNameTok.text, typeName: pType })
        parser: consumeIf(parser, TOK_COMMA)
    }
    parser: consume(parser, TOK_RPAREN)
    let rtr RetTypeResult: parseFnReturnType(parser)
    parser: rtr.parser
    let returnType String: rtr.returnType
    rtr.parser: {}
    drop(rtr)
    parser: consume(parser, TOK_LBRACE)
    let body Array<AstNode>: []
    while not currentTokenIs(parser, TOK_RBRACE) and not currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        body.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    parser: consume(parser, TOK_RBRACE)
    return {
        parser: parser
        stmt: {
            kind:       NODE_FN_DECL
            name:       nameTok.text
            params:     params
            returnType: returnType
            body:       body
        }
    }
}

fn parseFnReturnType(parser Parser) RetTypeResult {
    return match currentTokenIs(parser, TOK_VOID) {
        true: { parser: advance(parser), returnType: "void" }
        _:    match currentTokenIs(parser, TOK_LBRACE) {
            true: { parser: parser, returnType: "void" }
            _:    parseFnReturnTypeAnnotation(parser)
        }
    }
}

fn parseFnReturnTypeAnnotation(parser Parser) RetTypeResult {
    let tr TypeAnnResult: parseTypeAnnotation(parser)
    parser: tr.parser
    let t String: tr.typeName
    tr.parser: {}
    drop(tr)
    return { parser: parser, returnType: t }
}

fn parseTypeDeclaration(parser Parser) StmtResult {
    parser: consume(parser, TOK_TYPE)
    let nameTok Token: currentToken(parser)
    parser: consume(parser, TOK_IDENT)
    parser: consume(parser, TOK_COLON)
    parser: consume(parser, TOK_LBRACE)
    let fields Array<Param>: []
    while not currentTokenIs(parser, TOK_RBRACE) and not currentTokenIs(parser, TOK_EOF) {
        let fieldNameTok Token: currentToken(parser)
        parser: consume(parser, TOK_IDENT)
        let tr TypeAnnResult: parseTypeAnnotation(parser)
        parser: tr.parser
        let typeName String: tr.typeName
        tr.parser: {}
        drop(tr)
        fields.add({ name: fieldNameTok.text, typeName: typeName })
        parser: consumeIf(parser, TOK_COMMA)
    }
    parser: consume(parser, TOK_RBRACE)
    return { parser: parser, stmt: { kind: NODE_TYPE_DECL, name: nameTok.text, fields: fields } }
}

fn parseWhileStmt(parser Parser) StmtResult {
    parser: consume(parser, TOK_WHILE)
    let cr ParseResult: parseExpr(parser)
    parser: cr.parser
    let cond AstNode: cr.expr
    cr.parser: {}
    cr.expr:   {}
    drop(cr)
    parser: consume(parser, TOK_LBRACE)
    let body Array<AstNode>: []
    while not currentTokenIs(parser, TOK_RBRACE) and not currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        body.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    parser: consume(parser, TOK_RBRACE)
    return { parser: parser, stmt: { kind: NODE_WHILE, condition: cond, body: body } }
}

fn parseReturnStmt(parser Parser) StmtResult {
    parser: consume(parser, TOK_RETURN)
    let atEnd Bool: currentTokenIs(parser, TOK_RBRACE) or currentTokenIs(parser, TOK_EOF)
    return match atEnd {
        true: { parser: parser, stmt: { kind: NODE_RETURN, hasValue: false, value: {} } }
        _:    parseReturnValue(parser)
    }
}

fn parseReturnValue(parser Parser) StmtResult {
    let er ParseResult: parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    return { parser: parser, stmt: { kind: NODE_RETURN, hasValue: true, value: val } }
}

fn parseLetStmt(parser Parser) StmtResult {
    parser: consume(parser, TOK_LET)
    let nameTok Token: currentToken(parser)
    parser: consume(parser, TOK_IDENT)
    let tr TypeAnnResult: parseTypeAnnotation(parser)
    parser: tr.parser
    let typeName String: tr.typeName
    tr.parser: {}
    drop(tr)
    parser: consume(parser, TOK_COLON)
    let er ParseResult: parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    return { parser: parser, stmt: { kind: NODE_LET, name: nameTok.text, typeName: typeName, value: val } }
}

fn parseIdentStmt(parser Parser) StmtResult {
    return match peekIs(parser, TOK_COLON) {
        true: parseAssignStmt(parser)
        _:    parseIdentExprOrFieldAssign(parser)
    }
}

fn parseAssignStmt(parser Parser) StmtResult {
    let name String: currentToken(parser).text
    parser: advance(parser)
    parser: consume(parser, TOK_COLON)
    let er ParseResult: parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    return { parser: parser, stmt: { kind: NODE_ASSIGN, name: name, value: val } }
}

fn parseIdentExprOrFieldAssign(parser Parser) StmtResult {
    let pr ParseResult: parsePostfixChain(parser, parsePrimary(parser))
    parser: pr.parser
    let expr AstNode: pr.expr
    pr.parser: {}
    pr.expr:   {}
    drop(pr)
    return match expr.kind.equals(NODE_FIELD_ACCESS) and currentTokenIs(parser, TOK_COLON) {
        true: parseFieldAssignStmt(parser, expr)
        _:    { parser: parser, stmt: { kind: NODE_EXPR_STMT, expr: expr } }
    }
}

fn parseFieldAssignStmt(parser Parser, fieldExpr AstNode) StmtResult {
    parser: consume(parser, TOK_COLON)
    let er ParseResult: parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    return { parser: parser, stmt: { kind: NODE_FIELD_ASSIGN, receiver: fieldExpr.receiver, fieldName: fieldExpr.fieldName, value: val } }
}

fn parseExprStmt(parser Parser) StmtResult {
    let er ParseResult: parseExpr(parser)
    parser: er.parser
    let val AstNode: er.expr
    er.parser: {}
    er.expr:   {}
    drop(er)
    return { parser: parser, stmt: { kind: NODE_EXPR_STMT, expr: val } }
}

fn parse(tokens Array<Token>) AstModule {
    let parser Parser: {
        pos:    0
        tokens: tokens
    }
    let stmts Array<AstNode>: []
    while not currentTokenIs(parser, TOK_EOF) {
        let r StmtResult: parseStatement(parser)
        stmts.add(r.stmt)
        parser: r.parser
        r.stmt:   {}
        r.parser: {}
        drop(r)
    }
    return { stmts: stmts }
}

fn makeIndent(indent String) String {
    return indent.append("  ")
}

fn printModule(ast AstModule, path String) {
    printLn("Module [".append(path).append("]"))
    let i Int64: 0
    while i.lt(ast.stmts.len()) {
        let s AstNode: ast.stmts.at(i)
        printStmt(s, "  ")
        i: i.add(1)
    }
}

fn printStmt(stmt AstNode, indent String) {
    let k Int64: stmt.kind
    match k {
        NODE_FN_DECL:      printStmtFnDecl(stmt, indent)
        NODE_LET:          printStmtLet(stmt, indent)
        NODE_ASSIGN:       printStmtAssign(stmt, indent)
        NODE_FIELD_ASSIGN: printStmtFieldAssign(stmt, indent)
        NODE_RETURN:       printStmtReturn(stmt, indent)
        NODE_WHILE:        printStmtWhile(stmt, indent)
        NODE_INCLUDE:      printLn(indent.append("IncludeDirective [\"").append(stmt.path).append("\"] as [").append(stmt.ns).append("]"))
        NODE_EXPR_STMT:    printStmtExpr(stmt, indent)
        NODE_TYPE_DECL:    printStmtTypeDecl(stmt, indent)
        _:                 printLn(indent.append("UnknownStatement"))
    }
}

fn printStmtFnDecl(stmt AstNode, indent String) {
    let paramStr String: buildParamStr(stmt.params)
    printLn(indent.append("FunctionDeclaration [").append(stmt.name).append("](").append(paramStr).append(") -> ").append(stmt.returnType))
    let bodyIndent String: makeIndent(indent)
    let i Int64: 0
    while i.lt(stmt.body.len()) {
        let s AstNode: stmt.body.at(i)
        printStmt(s, bodyIndent)
        i: i.add(1)
    }
}

fn printStmtLet(stmt AstNode, indent String) {
    printLn(indent.append("LetStatement [").append(stmt.name).append("] : ").append(stmt.typeName))
    printExpr(stmt.value, makeIndent(indent))
}

fn printStmtAssign(stmt AstNode, indent String) {
    printLn(indent.append("AssignmentStatement [").append(stmt.name).append("]"))
    printExpr(stmt.value, makeIndent(indent))
}

fn printStmtFieldAssign(stmt AstNode, indent String) {
    printLn(indent.append("FieldAssignment [.").append(stmt.fieldName).append("]"))
    printExpr(stmt.receiver, makeIndent(indent))
    printExpr(stmt.value, makeIndent(indent))
}

fn printStmtReturn(stmt AstNode, indent String) {
    printLn(indent.append("ReturnStatement"))
    match stmt.hasValue {
        true: printExpr(stmt.value, makeIndent(indent))
    }
}

fn printStmtWhile(stmt AstNode, indent String) {
    printLn(indent.append("WhileStatement"))
    let bodyIndent String: makeIndent(indent)
    printExpr(stmt.condition, bodyIndent)
    let i Int64: 0
    while i.lt(stmt.body.len()) {
        let s AstNode: stmt.body.at(i)
        printStmt(s, bodyIndent)
        i: i.add(1)
    }
}

fn printStmtExpr(stmt AstNode, indent String) {
    printLn(indent.append("ExpressionStatement"))
    printExpr(stmt.expr, makeIndent(indent))
}

fn printStmtTypeDecl(stmt AstNode, indent String) {
    printLn(indent.append("TypeDeclaration [").append(stmt.name).append("]"))
    let fieldIndent String: makeIndent(indent)
    let i Int64: 0
    while i.lt(stmt.fields.len()) {
        let f AstNode: stmt.fields.at(i)
        printLn(fieldIndent.append("Field [").append(f.name).append("] Type [").append(f.typeName).append("]"))
        i: i.add(1)
    }
}

fn buildParamStr(params Array<Param>) String {
    let result String: ""
    let i Int64: 0
    while i.lt(params.len()) {
        let p Param: params.at(i)
        let sep String: match i.gt(0) { true: ", ", _: "" }
        result: result.append(sep).append(p.name).append(" : ").append(p.typeName)
        i: i.add(1)
    }
    return result
}

fn printExpr(expr AstNode, indent String) {
    let k Int64: expr.kind
    match k {
        NODE_BOOL_LIT:    printExprBool(expr, indent)
        NODE_INT_LIT:     printLn(indent.append("IntLiteral [").append(expr.text).append("]"))
        NODE_FLOAT_LIT:   printLn(indent.append("FloatLiteral [").append(expr.text).append("]"))
        NODE_STR_LIT:     printExprString(expr, indent)
        NODE_VAR_REF:     printLn(indent.append("VariableRef [").append(expr.name).append("]"))
        NODE_CALL:        printExprCall(expr, indent)
        NODE_METHOD_CALL: printExprMethodCall(expr, indent)
        NODE_FIELD_ACCESS: printExprFieldAccess(expr, indent)
        NODE_ARRAY_LIT:   printExprArrayLit(expr, indent)
        NODE_STRUCT_LIT:  printExprStructLit(expr, indent)
        NODE_MATCH:       printExprMatch(expr, indent)
        NODE_UNARY:       printExprUnary(expr, indent)
        NODE_BINARY:      printExprBinary(expr, indent)
        _:                printLn(indent.append("UnknownExpr"))
    }
}

fn printExprBool(expr AstNode, indent String) {
    let val String: match expr.value { true: "true", _: "false" }
    printLn(indent.append("BoolLiteral [").append(val).append("]"))
}

fn printExprString(expr AstNode, indent String) {
    let escaped String: escapeForPrint(expr.text)
    printLn(indent.append("StringLiteral [\"").append(escaped).append("\"]"))
}

fn printExprCall(expr AstNode, indent String) {
    printLn(indent.append("CallExpression [").append(expr.name).append("]"))
    let argIndent String: makeIndent(indent)
    let i Int64: 0
    while i.lt(expr.args.len()) {
        let a AstNode: expr.args.at(i)
        printExpr(a, argIndent)
        i: i.add(1)
    }
}

fn printExprMethodCall(expr AstNode, indent String) {
    printLn(indent.append("MethodCall [.").append(expr.methodName).append("]"))
    let argIndent String: makeIndent(indent)
    printExpr(expr.receiver, argIndent)
    let i Int64: 0
    while i.lt(expr.args.len()) {
        let a AstNode: expr.args.at(i)
        printExpr(a, argIndent)
        i: i.add(1)
    }
}

fn printExprFieldAccess(expr AstNode, indent String) {
    printLn(indent.append("FieldAccess [.").append(expr.fieldName).append("]"))
    printExpr(expr.receiver, makeIndent(indent))
}

fn printExprArrayLit(expr AstNode, indent String) {
    printLn(indent.append("ArrayLiteral [").append(expr.count.toString()).append(" elements]"))
    let argIndent String: makeIndent(indent)
    let i Int64: 0
    while i.lt(expr.elems.len()) {
        let e AstNode: expr.elems.at(i)
        printExpr(e, argIndent)
        i: i.add(1)
    }
}

fn printExprStructLit(expr AstNode, indent String) {
    printLn(indent.append("StructLiteral [").append(expr.count.toString()).append(" fields]"))
    let fieldIndent String: makeIndent(indent)
    let valIndent String: makeIndent(fieldIndent)
    let i Int64: 0
    while i.lt(expr.fields.len()) {
        let f AstNode: expr.fields.at(i)
        printLn(fieldIndent.append("Field [").append(f.name).append("]"))
        printExpr(f.value, valIndent)
        i: i.add(1)
    }
}

fn printExprMatch(expr AstNode, indent String) {
    printLn(indent.append("MatchExpression [").append(expr.count.toString()).append(" arms]"))
    let bodyIndent String: makeIndent(indent)
    let armIndent String: makeIndent(bodyIndent)
    printExpr(expr.condition, bodyIndent)
    let i Int64: 0
    while i.lt(expr.arms.len()) {
        let arm AstNode: expr.arms.at(i)
        let patLabel String: matchPatternLabel(arm.pattern, arm.isWildcard)
        printLn(bodyIndent.append("Arm [").append(patLabel).append("]"))
        printExpr(arm.body, armIndent)
        i: i.add(1)
    }
}

fn printExprUnary(expr AstNode, indent String) {
    printLn(indent.append("UnaryExpression [Not]"))
    printExpr(expr.operand, makeIndent(indent))
}

fn printExprBinary(expr AstNode, indent String) {
    let opStr String: match expr.op.equals(OP_AND) { true: "And", _: "Or" }
    printLn(indent.append("BinaryExpression [").append(opStr).append("]"))
    let childIndent String: makeIndent(indent)
    printExpr(expr.left, childIndent)
    printExpr(expr.right, childIndent)
}

fn matchPatternLabel(pat AstNode, isWildcard Bool) String {
    return match isWildcard {
        true: "_"
        _:
        match pat.kind.equals(NODE_BOOL_LIT) {
            true: match pat.value { true: "true", _: "false" }
            _:
            match pat.kind.equals(NODE_INT_LIT) or pat.kind.equals(NODE_FLOAT_LIT) {
                true: pat.text
                _:
                match pat.kind.equals(NODE_STR_LIT) {
                    true: "\"".append(pat.text).append("\"")
                    _:
                        "VariableReferenceExpression"
                }
            }
        }
    }
}

fn escapeForPrint(s String) String {
    let result String: ""
    let i Int64: 0
    while i.lt(s.len()) {
        let ch String: s.at(i)
        let out String: match ch.equals("\n") {
            true: "\\n"
            _:
            match ch.equals("\t") {
                true: "\\t"
                _: ch
            }
        }
        result: result.append(out)
        i: i.add(1)
    }
    return result
}
